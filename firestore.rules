rules_version = '2';
// Строгие правила «Системы» (F4) — опубликованы в консоли Firebase 17.10.2026.
// Доступ к данным пространства — только у участников spaces/{sp}/members/{uid};
// стать участником можно, доказав код доступа: sha256(code) == spaces/{sp}.codeHash.
service cloud.firestore {
  match /databases/{database}/documents {
    match /spaces/{sp} {
      function signedIn() { return request.auth != null; }
      function member() {
        return signedIn() && exists(/databases/$(database)/documents/spaces/$(sp)/members/$(request.auth.uid));
      }
      function spaceData() { return get(/databases/$(database)/documents/spaces/$(sp)).data; }
      function dataColl(c) {
        return c in ['_meta', 'transactions', 'goals', 'budgets', 'templates', 'settings', 'learned',
                     'tasks', 'taskLog', 'habits', 'habitChecks', 'journal', 'debts', 'allocations',
                     'workoutPlans', 'workouts', 'bodyWeights', 'xpLog', 'importedStatements', 'backups'];
      }

      allow get: if member();
      allow list: if false;
      // новое пространство: codeHash обязан совпадать с идентификатором (= sha256 кода)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['codeHash', 'createdAt'])
        && request.resource.data.codeHash == sp;
      // смена кода участником
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codeHash', 'rotatedAt'])
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.size() == 64;
      allow delete: if false;

      match /members/{uid} {
        allow read, delete: if member();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'joinedAt', 'label'])
          && request.resource.data.code is string
          && hashing.sha256(request.resource.data.code).toHexString().lower() == spaceData().codeHash;
        // участник убирает код из своей записи и обновляет отметку
        allow update: if signedIn() && request.auth.uid == uid
          && !('code' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code', 'lastSeen', 'label']);
      }

      match /{coll}/{docId} {
        allow read, delete: if member() && dataColl(coll);
        allow create, update: if member() && dataColl(coll) && request.resource.data.size() <= 60;
      }
    }
  }
}
