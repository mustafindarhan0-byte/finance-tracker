# Скопируйте этот файл в .env и укажите токен, полученный у @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Необязательные настройки (значения по умолчанию):
# BINANCE_BASE_URL=https://api.binance.com   # если Binance блокирует регион: https://data-api.binance.vision
# ALERTS_DB_PATH=data/alerts.db
# ALERT_CHECK_INTERVAL=60                     # секунды между проверками уведомлений
# TOP_MIN_QUOTE_VOLUME=10000000               # минимальный оборот за 24ч (USDT) для /top
# LOG_LEVEL=INFO
